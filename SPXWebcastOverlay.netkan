spec_version: v1.4
identifier: SPXWebcastOverlay
name: SPX Webcast Overlay
abstract: Falcon 9 webcast-style telemetry overlay (clock, timeline, gauges) shown when the UI is hidden.
author: Morgan
$kref: '#/ckan/spacedock/<SPACEDOCK_ID>'
# Alternative (GitHub releases instead of SpaceDock):
# $kref: '#/ckan/github/MXZZ123/SPXWebcastOverlay'
$vref: '#/ckan/ksp-avc'
license: MIT
ksp_version_min: '1.12'
ksp_version_max: '1.12'
tags:
  - plugin
  - information
resources:
  repository: https://github.com/MXZZ123/SPXWebcastOverlay
  bugtracker: https://github.com/MXZZ123/SPXWebcastOverlay/issues
depends:
  - name: ToolbarController
  - name: ClickThroughBlocker
recommends:
  - name: TundraExploration
suggests:
  - name: kOS
install:
  - find: SPXWebcastOverlay
    install_to: GameData
